# Rinomina questo file in .env.local e inserisci i tuoi dati Firebase

# Dati di Firebase (Impostazioni Progetto -> Generale -> Le tue app)
VITE_FIREBASE_API_KEY="tua-api-key"
VITE_FIREBASE_AUTH_DOMAIN="tuo-progetto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tuo-progetto"
VITE_FIREBASE_STORAGE_BUCKET="tuo-progetto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="tuo-sender-id"
VITE_FIREBASE_APP_ID="tua-app-id"

# URL del server multiplayer (locale per test, oppure l'URL di Render/Fly quando lo pubblichi)
VITE_MULTIPLAYER_SERVER_URL="http://localhost:4000"

# Config del server (self-hosted sulla VM Oracle). Copia in .env sulla VM.

# Segreto per firmare i token di sessione (JWT). METTINE UNO LUNGO E CASUALE sulla VM.
# Esempio per generarne uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-questo-con-una-stringa-lunga-e-casuale"

# Porta del server (dietro nginx puoi tenerla su 4000; in diretto usa 80).
PORT=4000

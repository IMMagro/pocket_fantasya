# Config del server. In locale copia in .env; su Render si impostano nella dashboard.

# Connessione al database Postgres (Neon, piano gratuito).
# La trovi su Neon → Dashboard → Connection string (include utente e password).
DATABASE_URL="postgresql://utente:password@host.neon.tech/dbname?sslmode=require"

# Segreto per firmare i token di sessione (JWT). Su Render lo genera in automatico.
# In locale generane uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-questo-con-una-stringa-lunga-e-casuale"

# Porta del server (Render la imposta da sola; in locale default 4000).
PORT=4000
